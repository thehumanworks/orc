{
  "name": "orc",
  "version": "0.1.0",
  "description": "Multi-agent orchestration — run claude/codex/pi coding agents as durable, detached sessions driven over their structured protocols. SDK + `orc` CLI.",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "orc": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "verify:live": "bun scripts/verify-runtime/all.ts",
    "compile:cli": "bun build --compile ./src/cli/index.ts --outfile dist/orc",
    "install:cli": "bun run compile:cli && mv dist/orc ~/.local/bin/orc"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0"
  }
}
