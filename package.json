{
  "name": "orc",
  "version": "0.1.0",
  "description": "Multi-agent orchestration tool — launch claude/codex/pi coding agents as detached, reattachable, readable tmux sessions. SDK + `orc` CLI.",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "orc": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "compile:cli": "bun build --compile ./src/cli/index.ts --outfile dist/orc",
    "install:cli": "bun run compile:cli && mv dist/orc ~/.local/bin/orc"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5"
  }
}
