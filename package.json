{
  "name": "orc",
  "version": "0.1.0",
  "description": "Multi-agent orchestration \u2014 run Pi and Claude coding agents as durable, detached sessions over structured protocols. OpenAI and Codex models run through Pi. SDK + `orc` CLI.",
  "type": "module",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "bin": {
    "orc": "./src/cli/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.3"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "verify:live": "bun scripts/verify-runtime/all.ts",
    "compile:cli": "bun build --compile --no-compile-autoload-dotenv --no-compile-autoload-bunfig ./src/cli/index.ts --outfile dist/orc",
    "install:cli": "bun run compile:cli && mv dist/orc ~/.local/bin/orc",
    "check:compile": "bun run compile:cli && bun scripts/verify-runtime/compiled.ts ./dist/orc"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/bun": "latest",
    "typescript": "^5"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5"
  }
}
